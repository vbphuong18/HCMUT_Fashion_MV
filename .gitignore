# Whitelist: ignore everything at the root by default, then allow chosen folders.
# Datasets, checkpoints, personal documents and archived drafts stay local-only
# even when new files are dropped into the project root.
/*
!/.gitignore
!/README.md
!/report/
!/src/
!/results/
!/docs/
!/.gitmodules
!/external/
!/configs/
!/scripts/
!/tests/
!/pytest.ini
!/requirements-train.txt
!/docker/
!/.dockerignore

# ---- credentials: never commit ----
/.secrets/

# ---- report/: LaTeX sources, figures and the final PDF ----
/report/build/

# ---- results/: keep JSON + logs, drop regenerable embedding caches ----
/results/baselines/cache/

# ---- docs/: keep proposal + literature review only ----
# Paper PDF/full text and the full Vietnamese translation are copyrighted or derivative.
/docs/paper/
/docs/translation/

# ---- LaTeX build artifacts anywhere ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.log
!/results/baselines/logs/*.log
!/results/procir/logs/*.log
!/results/procir_train/logs/*.log

# ---- Python / OS ----
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Local-only folders at the root (already excluded by the whitelist above):
#   data/        datasets, images, checkpoints, raw zips, Kaggle downloads
#   FashionMV/   clone of https://github.com/yuandaxia2001/FashionMV
#   personal/    CV, transcripts
#   archive/     old drafts, backups and duplicate files

# ---- Jupyter autosave copies (the server notebook is saved inside the repo) ----
.ipynb_checkpoints/
